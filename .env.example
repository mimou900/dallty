# Copy to .env and fill in real values locally. Never commit .env (already gitignored).
# In Vercel, set these as Environment Variables per environment (Production/Preview/
# Development) instead of committing a file — see docs/DALLTY_DEPLOYMENT.md.

# --- Supabase (server-only; NEVER exposed to browser code) ---
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# --- Supabase (browser-safe, VITE_-prefixed so Vite exposes them to client code) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Auth / security ---
OTP_HMAC_SECRET=

# --- Transactional email (server-only; Resend) ---
RESEND_API_KEY=

# --- Supabase Auth "Send Email" hook (server-only) ---
# Standard Webhooks secret configured on the hook in Supabase's dashboard.
# See src/routes/auth/email-hook.ts — hook is built but NOT yet enabled in
# Supabase's live Auth config (hook_send_email_enabled: false).
SUPABASE_AUTH_EMAIL_HOOK_SECRET=

# --- Google Maps (browser-safe) ---
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_TRACKING_ID=

# --- Google Routes API (server-only; travel-time calculation) ---
GOOGLE_MAPS_API_KEY=

# --- Mapbox (browser-safe; Search results map, lazy-loaded) ---
VITE_MAPBOX_TOKEN=
